# Server Configuration
PORT=3000
NODE_ENV=development

# Primary AI Provider: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Secondary AI Provider: Hugging Face
HF_TOKEN=your_huggingface_token_here
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Instagram / Meta Graph API
INSTAGRAM_ACCESS_TOKEN=IGAAZAhvxtLdRRBZAFl0UUxCTTlqMjNDaHRYR0J1b24zT2RwQWNSak5oT09rLUZAYSGZAtdGQ0SzJRLXRaNjdJUWVrdlM4cTFhMGZAYZA2NJUEpDb3VPaVNrSGNuX1NxOG94MWk1YmRNaVBCemNidGZAqenNHVWtNUlpUa0EyNnZA4VU1rTQZDZD
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
META_VERIFY_TOKEN=your_custom_webhook_verify_token
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Reply and Fallback Defaults
PUBLIC_REPLY=false
FALLBACK_MESSAGE=Hey 👋 Thanks for your comment! You can find the requested information here: https://theru3x.com/links
ALLOWED_URL=https://theru3x.com/links

# MongoDB Database URI (e.g. MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/insta_automation?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/insta_automation

# AI Limits, Backoff & Circuit Breaker
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=3
AI_BACKOFF_BASE_MS=1000
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000

# Optional Admin Key for API security
ADMIN_API_KEY=
BUSINESS_DESCRIPTION=We provide premium developer tools, AI automation solutions, and productivity resources.
OFFER_INFO=Official resources, portfolio, links, and contact information.
